# =============================================================================
# StatusPulse — Environment Variables
# Copy this file to .env and fill in the values:  cp .env.example .env
# =============================================================================

# --- Application ---
APP_PORT=8000

# --- PostgreSQL ---
DB_HOST=db
DB_PORT=5432
DB_NAME=statuspulse
DB_USER=postgres
DB_PASSWORD=changeme_use_a_strong_password

# --- PostgreSQL external port (host access) ---
DB_PORT_EXTERNAL=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_use_a_strong_password

# --- Redis external port (host access) ---
REDIS_PORT_EXTERNAL=6379
